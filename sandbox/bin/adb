#!/usr/bin/env bash
# 桩 adb：只回话，不碰手机。行为由 SBX_* 环境变量决定。
# 每个 input 事件都追加到 $SBX_EVENTS，用来数"到底点了几下、点了什么"。
ev() { [ -n "${SBX_EVENTS:-}" ] && printf '%s\n' "$*" >>"$SBX_EVENTS"; return 0; }

args=("$@")
rest=()
skip=0
for a in "${args[@]}"; do
  if [ $skip = 1 ]; then skip=0; continue; fi
  if [ "$a" = "-s" ]; then skip=1; continue; fi
  rest+=("$a")
done
sub="${rest[*]}"

case "$sub" in
  devices)
    printf 'List of devices attached\n'
    [ "${SBX_OFFLINE:-0}" = 1 ] || printf '%s\tdevice\n' "${SBX_DEV:-192.168.1.110:16132}"
    ;;
  start-server) : ;;
  connect*)
    if [ "${SBX_OFFLINE:-0}" = 1 ]; then printf 'failed to connect\n'; else printf 'connected\n'; fi
    ;;
  "shell input tap "*)   ev "tap ${sub#shell input tap }" ;;
  "shell input swipe "*) ev "swipe ${sub#shell input swipe }" ;;
  "shell input keyevent "*) ev "key ${sub#shell input keyevent }" ;;
  "shell uiautomator dump"*) printf 'UI dump written to /sdcard/pdd_dump.xml\n' ;;
  "exec-out screencap"*) cat "${SBX_SHOT:-/dev/null}" ;;
  "exec-out cat "*)      cat "${SBX_XML:-/dev/null}" ;;
  "shell dumpsys power"*) printf 'mWakefulness=%s\n' "${SBX_WAKE:-Awake}" ;;
  "shell dumpsys window"*)
    if [ "${SBX_LOCK:-0}" = 1 ]; then printf 'mShowingLockscreen=true\n'; fi
    # 焦点默认是首页；$SBX_FACT_AFTER_TAP / $SBX_FACT_AFTER_BACK 一旦配上，
    # 就从"事件日志里出现过 tap / KEYCODE_BACK"那一刻起换成它 —— 用来演
    # 「点一下页面就走」和「BACK 把弹窗退掉」这两种真机行为（10-30 那条入口吞枪用例）。
    fact="${SBX_FACT:-com.xunmeng.pinduoduo.ui.activity.HomeActivity}"
    fpkg="${SBX_FPKG:-com.xunmeng.pinduoduo}"
    if [ -n "${SBX_EVENTS:-}" ] && [ -f "$SBX_EVENTS" ]; then
      if [ -n "${SBX_FACT_AFTER_TAP:-}" ] && grep -q '^tap ' "$SBX_EVENTS"; then
        fact="$SBX_FACT_AFTER_TAP"
      fi
      if [ -n "${SBX_FACT_AFTER_BACK:-}" ] && grep -q '^key KEYCODE_BACK$' "$SBX_EVENTS"; then
        fact="$SBX_FACT_AFTER_BACK"
      fi
    fi
    printf 'mCurrentFocus=Window{ab12cd3 u0 %s/%s}\n' "$fpkg" "$fact"
    ;;
  "shell wm size"*) printf 'Physical size: %s\nOverride size: %s\n' \
      "${SBX_SIZE:-720x1280}" "${SBX_SIZE:-720x1280}" ;;
  "shell wm dismiss-keyguard") : ;;
  "shell am "*) ev "${sub#shell }" ;;
  *) : ;;
esac
exit 0

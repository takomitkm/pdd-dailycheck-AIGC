# 沙箱产物与真机证据一律不入库
sandbox/out/
pdd-runs/
__pycache__/
*.pyc

# 备份和临时件
*.bak
*.bak-*
pdd.sh.bak*
.tmp/
tmp/

# 推送端点（带 ServerChan token，等于凭据）只活在主机 ~/Desktop/pdd-push.url 里
pdd-push.url
*.push.url
push.url

# 离线归因的接口端点 + key，同理只活在主机 ~/Desktop/pdd-vlm.url 里（第 1 行 URL、第 2 行 key）
pdd-vlm.url
*.vlm.url
vlm.url

# OCR 调用配置：11-01 起不进仓库、不跟云端同步。唯一一份现役文件在主机
# ~/Desktop/pdd-ocr.conf（600），调参数就在那里改；仓库里留下的任何副本都不作数、也别 scp 上去覆盖它。
pdd-ocr.conf
*-ocr.conf

# 标定过程中的大图矩阵（140MB 量级，用 tools/ 从证据帧现生成）
bench*/
frames*/
exp/

# refactor-v2：门禁/测量产物不入库
reports/
.venv/
# 但重构规划里的测量代码目录要入库（上面 bench*/ 原指标定大图目录，这里显式豁免）
!bench/
!benchmarks/
